NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-desktop-instance-password
NEO4J_DATABASE=neo4j
OPS_DB_PATH=data/ops.db
ONTOLOGY_PATH=config/ontology.yaml
CONTRACTS_PATH=config/contracts.yaml
PROMPTS_PATH=config/prompts.yaml
MIGRATIONS_PATH=migrations
EMBEDDING_DIMENSIONS=1536
# Optional: only set for an explicitly supervised external Knowledge Service.
# MCP_BASE_URL=http://127.0.0.1:8000
MCP_WORKSPACE_ID=personal
MCP_PRINCIPALS=local-user
# Required only when MCP_PRINCIPALS contains more than one identity.
# MCP_ACTOR=local-user
# Required before MCP can create governed Action requests. These identities are host policy,
# never model arguments. No Action approval or execution tool is exposed through MCP.
# MCP_ACTION_REVIEW_PRINCIPALS=local-user
# MCP_ACTION_EXECUTION_PRINCIPALS=local-connector
MCP_ACTION_POLICY_VERSION=action-policy-v1
# Optional fail-closed per-capability override. When set, undeclared Action types are rejected.
# MCP_ACTION_POLICY_VERSIONS=NOTION_CREATE_PAGE=notion-create-page-policy-v1,NOTION_ARCHIVE_PAGE=notion-archive-page-policy-v1
MCP_TIMEOUT_SECONDS=30

# Local human-review adapter. With multiple principals, REVIEW_ACTOR is required.
REVIEW_WORKSPACE_ID=personal
REVIEW_PRINCIPALS=local-user
# REVIEW_ACTOR=local-user
# REVIEW_BASE_URL=http://127.0.0.1:8000
REVIEW_TIMEOUT_SECONDS=30

# Governed Action executor. Omit the base URL to use the same local in-process Knowledge Service.
# ACTION_EXECUTOR_BASE_URL=http://127.0.0.1:8000
ACTION_EXECUTOR_TIMEOUT_SECONDS=30

# Read-only Notion connection secret; never commit a real value.
# NOTION_TOKEN=secret_replace_me
# For durable local operation, prefer an owner-only file outside Git. When unset, the connector
# checks ~/.config/knowledge-os/notion_token after NOTION_TOKEN.
# NOTION_TOKEN_FILE=/absolute/path/to/notion_token

# Google Drive uses authorized-user ADC from this optional path, or defaults to
# ~/.config/gcloud/application_default_credentials.json. Never copy credentials into the repo.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/application_default_credentials.json
# Optional one-run override; a short-lived access token takes precedence over ADC.
# GOOGLE_DRIVE_TOKEN=short_lived_access_token
