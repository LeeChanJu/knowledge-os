{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Knowledge OS Explorer documentation (not runtime ontology)",
  "$defs": {
    "reference": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "test",
            "document",
            "migration",
            "configuration",
            "function",
            "class"
          ]
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "domain",
        "description",
        "responsibilities",
        "inputs",
        "outputs",
        "owns",
        "invariants",
        "gaps",
        "deferrals",
        "contracts",
        "status",
        "overview",
        "references"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deferrals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "VERIFIED",
            "IMPLEMENTED",
            "KNOWN ISSUE",
            "DEFERRED"
          ]
        },
        "overview": {
          "type": "boolean"
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "verification": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "title",
        "scope",
        "limitations",
        "status",
        "affects",
        "tests",
        "sources",
        "dependencies",
        "recordedOutcome",
        "environment",
        "revision",
        "resolutionRequired"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "VERIFIED",
            "IMPLEMENTED",
            "KNOWN ISSUE",
            "DEFERRED"
          ]
        },
        "affects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "recordedOutcome": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "resolutionRequired": {
          "type": "string"
        },
        "revisionScope": {
          "enum": [
            "repository",
            "original-source-history"
          ]
        }
      }
    },
    "curated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "domains",
        "notes",
        "nodes",
        "edges"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "color"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "color": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "target",
              "label",
              "references",
              "overview"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "overview": {
                "type": "boolean"
              },
              "references": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/reference"
                }
              }
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "policy",
        "authorities",
        "claims",
        "reviewedEvaluationDocuments"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "policy": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authorities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "fingerprint",
              "rationale"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "anchor": {
                "type": "string",
                "minLength": 1
              },
              "fingerprint": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "reviewedEvaluationDocuments": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "required": [
        "schemaVersion",
        "evidenceDigest",
        "baselineRevision",
        "nodes",
        "edges",
        "verification",
        "domains",
        "notes"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "evidenceDigest": {
          "type": "string",
          "minLength": 1
        },
        "baselineRevision": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "status",
              "references"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "VERIFIED",
                  "IMPLEMENTED",
                  "KNOWN ISSUE",
                  "DEFERRED"
                ]
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "source",
              "target",
              "label",
              "references"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "verification": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    }
  }
}
