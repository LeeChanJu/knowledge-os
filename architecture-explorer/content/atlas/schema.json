{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schemaVersion",
    "milestone",
    "backbones",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "milestone": {
      "const": "M1\u2013M2"
    },
    "backbones": {
      "type": "object",
      "required": [
        "runtime",
        "engineering"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "labels",
          "content",
          "branches",
          "referenceIds",
          "claimIds",
          "architectureNodeIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z-]*$"
          },
          "labels": {
            "type": "object",
            "required": [
              "en",
              "ko-KR"
            ],
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "content": {
            "type": "object",
            "required": [
              "en",
              "ko-KR"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "branches": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "referenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claimIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "opposite": {
            "type": "object",
            "required": [
              "axis",
              "node"
            ],
            "properties": {
              "axis": {
                "enum": [
                  "runtime",
                  "engineering"
                ]
              },
              "node": {
                "type": "string"
              }
            }
          },
          "architectureNodeIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "term": {
            "type": "string"
          },
          "documentId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "target",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "sequence",
              "branch",
              "cross-axis"
            ]
          },
          "axis": {
            "enum": [
              "runtime",
              "engineering"
            ]
          }
        }
      }
    }
  }
}
