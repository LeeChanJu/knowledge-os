{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schemaVersion",
    "milestone",
    "backbones",
    "nodes",
    "edges",
    "journeys"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "milestone": {
      "const": "M3–M5"
    },
    "backbones": {
      "type": "object",
      "required": [
        "runtime",
        "engineering"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "labels",
          "content",
          "branches",
          "referenceIds",
          "claimIds",
          "architectureNodeIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z-]*$"
          },
          "labels": {
            "type": "object",
            "required": [
              "en",
              "ko-KR"
            ],
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "content": {
            "type": "object",
            "required": [
              "en",
              "ko-KR"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "branches": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "referenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claimIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "opposite": {
            "type": "object",
            "required": [
              "axis",
              "node"
            ],
            "properties": {
              "axis": {
                "enum": [
                  "runtime",
                  "engineering"
                ]
              },
              "node": {
                "type": "string"
              },
              "journey": {
                "enum": [
                  "read",
                  "ingest",
                  "sources",
                  "remember",
                  "correct",
                  "act"
                ]
              }
            }
          },
          "architectureNodeIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "term": {
            "type": "string"
          },
          "documentId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "target",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "sequence",
              "branch",
              "cross-axis"
            ]
          },
          "axis": {
            "enum": [
              "runtime",
              "engineering"
            ]
          }
        }
      }
    },
    "journeys": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "labels",
          "backbone",
          "boundaries",
          "checkContent"
        ],
        "properties": {
          "id": {
            "enum": [
              "read",
              "ingest",
              "sources",
              "remember",
              "correct",
              "act"
            ]
          },
          "labels": {
            "type": "object",
            "required": [
              "ko-KR",
              "en"
            ],
            "additionalProperties": false,
            "properties": {
              "ko-KR": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "backbone": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "boundaries": {
            "type": "object",
            "required": [
              "target",
              "current",
              "human",
              "deferred"
            ],
            "additionalProperties": false,
            "properties": {
              "target": {
                "type": "object",
                "required": [
                  "ko-KR",
                  "en"
                ],
                "additionalProperties": false,
                "properties": {
                  "ko-KR": {
                    "type": "string",
                    "minLength": 1
                  },
                  "en": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "current": {
                "type": "object",
                "required": [
                  "ko-KR",
                  "en"
                ],
                "additionalProperties": false,
                "properties": {
                  "ko-KR": {
                    "type": "string",
                    "minLength": 1
                  },
                  "en": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "human": {
                "type": "object",
                "required": [
                  "ko-KR",
                  "en"
                ],
                "additionalProperties": false,
                "properties": {
                  "ko-KR": {
                    "type": "string",
                    "minLength": 1
                  },
                  "en": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "deferred": {
                "type": "object",
                "required": [
                  "ko-KR",
                  "en"
                ],
                "additionalProperties": false,
                "properties": {
                  "ko-KR": {
                    "type": "string",
                    "minLength": 1
                  },
                  "en": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "checkContent": {
            "type": "object",
            "required": [
              "en",
              "ko-KR"
            ],
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
